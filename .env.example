# ==============================================================================
# Sanjeevani Environment Configuration
# ==============================================================================
#
# ZERO CONFIGURATION NOTE:
# If you leave these values empty or omit the .env file entirely, Sanjeevani
# will automatically run in local zero-config fallback mode:
# - Firebase Firestore -> Browser localStorage with real-time DOM events
# - Gemini AI API      -> Safe offline rule-based clinical triage engine
#
# To connect real cloud services, copy this file to .env and fill in real keys.

# ------------------------------------------------------------------------------
# 1. Google Firebase Firestore (Database)
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 2. Google Gemini API (AI Urgency Triage)
# Obtain this from: Google AI Studio (https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your_gemini_api_key_here
